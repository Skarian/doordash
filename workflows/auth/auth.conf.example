# Copy selected values to ~/.config/dd-cli-linux/auth.conf.

# Passwordless noVNC listener. Use 127.0.0.1 for SSH-forwarding-only access.
DD_MOBILE_BIND="0.0.0.0"
DD_MOBILE_PORT="6080"

# Optional externally advertised URL supplied by a reverse proxy or provider.
# DD_MOBILE_PUBLIC_URL="https://door.example.net/"

# Interactive-session lifetime and post-success grace period.
DD_MOBILE_MAX_SECONDS="900"
DD_MOBILE_SUCCESS_GRACE_SECONDS="10"

# Optional binary/browser overrides.
# DD_CLI_BIN="$HOME/.local/bin/dd-cli"
# DD_CHROME_BIN="/usr/bin/google-chrome-stable"
